{
  "expo": {
    "name": "MiProgreso Gym",
    "slug": "miprogreso-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miprogresogym",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ignaciohm.miprogresogym"
    },
    "android": {
      "package": "com.ignaciohm.miprogresogym",
      "adaptiveIcon": {
        "backgroundColor": "#121417",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121417",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/rest_alarm.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
